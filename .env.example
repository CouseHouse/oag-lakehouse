# Copy to .env and fill in. .env is gitignored. Never commit real values.
# The YAML config files name these variables; adapters read them at startup.

# NVD (https://nvd.nist.gov/developers/request-an-api-key). Raises the rate limit to 50 requests per 30 s.
NVD_API_KEY=

# Ozone S3 gateway (unsecured in Phases 1 to 6; any pair works, but set them anyway)
OAG_S3_ACCESS_KEY=
OAG_S3_SECRET_KEY=

# Polaris principal (created by infra/local/polaris bootstrap)
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=

# vLLM bearer token on the workstation
VLLM_API_KEY=

# Langfuse project keys (Phase 4)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# PostgreSQL (pgvector, AGE, Airflow metadata, Langfuse)
PGVECTOR_PASSWORD=
AGE_PASSWORD=
AIRFLOW_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=

# PuppyGraph (change the default)
PUPPYGRAPH_PASSWORD=

# NiFi single-user credentials and sensitive props key
NIFI_USERNAME=
NIFI_PASSWORD=
NIFI_SENSITIVE_PROPS_KEY=

# Trino password file entry for the agent
TRINO_PASSWORD=

# Cloudera transfer only (OAG_ENV=cloudera, Phase 8)
CDP_ACCESS_TOKEN=
CAI_INFERENCE_TOKEN=
